NODE_ENV=local
PORT=4000

# Same Postgres database the Go admin engine (Fitstore-engine) writes to.
DATABASE_URL="postgres://postgres:root@localhost:5432/tshirt_store?sslmode=disable"
FRONTEND_URL=http://localhost:5173
FITSTORE_WEB=https://fitstore-web.vercel.app/orders/pending

# Separate from the Go admin engine's JWT_SECRET - this signs customer (cust_user) auth tokens.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Gmail SMTP - SMTP_USER is the sending Gmail address, SMTP_PASS is a 16-char
# Gmail App Password (Google Account > Security > 2-Step Verification > App
# Passwords), NOT the account's normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFICATION_EMAIL=karthikbhatt22@gmail.com

# Order notifications actually go out via Telegram now (see
# src/services/telegram.service.js) - Render blocks outbound SMTP entirely.
# Get TELEGRAM_BOT_TOKEN from @BotFather (/newbot). TELEGRAM_CHAT_ID supports
# multiple people - comma-separated chat IDs, each obtained by that person
# messaging the bot once, then visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates and reading "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
