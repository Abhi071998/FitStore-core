generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id         BigInt     @id @default(autoincrement())
  name       String     @unique(map: "uni_categories_name") @db.VarChar(255)
  created_at DateTime?  @db.Timestamptz(6)
  updated_at DateTime?  @db.Timestamptz(6)
  deleted_at DateTime?  @db.Timestamptz(6)
  image_url  String?
  products   products[]

  @@index([deleted_at], map: "idx_categories_deleted_at")
}

model product_sizes {
  id         BigInt    @id @default(autoincrement())
  product_id BigInt
  size       String    @db.VarChar(10)
  stock      BigInt    @default(0)
  created_at DateTime? @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_products_sizes")
  temp_order  temp_order[]
  order_items order_items[]

  @@index([deleted_at], map: "idx_product_sizes_deleted_at")
  @@index([product_id], map: "idx_product_sizes_product_id")
}

model products {
  id             BigInt          @id @default(autoincrement())
  name           String          @db.VarChar(255)
  brand          String?         @default("FITstore") @db.VarChar(100)
  description    String?
  product_code   String          @unique(map: "uni_products_product_code") @db.VarChar(100)
  sku            String          @unique(map: "uni_products_sku") @db.VarChar(100)
  mrp            Decimal         @db.Decimal(10, 2)
  selling_price  Decimal         @db.Decimal(10, 2)
  discount       BigInt?         @default(0)
  images         String?
  specifications Json?
  category_id    BigInt
  created_at     DateTime?       @db.Timestamptz(6)
  updated_at     DateTime?       @db.Timestamptz(6)
  deleted_at     DateTime?       @db.Timestamptz(6)
  product_sizes  product_sizes[]
  categories     categories      @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categories_products")

  @@index([category_id], map: "idx_products_category_id")
  @@index([deleted_at], map: "idx_products_deleted_at")
}

model users {
  id         BigInt    @id @default(autoincrement())
  email      String    @unique(map: "uni_users_email") @db.VarChar(255)
  name       String    @db.VarChar(255)
  password   String    @db.VarChar(255)
  created_at DateTime? @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  @@index([deleted_at], map: "idx_users_deleted_at")
}

model cust_user {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar(255)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  temp_order temp_order[]
  orders     orders[]

  @@index([deleted_at])
}

// The bag: one row per (customer, product size). No stock is reserved here -
// only checked. Cleared once its rows are converted into an order on submit.
model temp_order {
  id              BigInt   @id @default(autoincrement())
  cust_user_id    BigInt
  product_size_id BigInt
  quantity        BigInt
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  cust_user     cust_user     @relation(fields: [cust_user_id], references: [id], onDelete: Cascade)
  product_sizes product_sizes @relation(fields: [product_size_id], references: [id], onDelete: Cascade)

  @@unique([cust_user_id, product_size_id])
}

// A submitted bag, pending admin approval. Stock is reserved (decremented)
// the moment an order is created, not when items are added to the bag.
model orders {
  id               BigInt    @id @default(autoincrement())
  cust_user_id     BigInt
  status           String    @default("pending_approval") @db.VarChar(30)
  shipping_name    String?   @db.VarChar(255)
  shipping_email   String?   @db.VarChar(255)
  shipping_address String?
  shipping_city    String?   @db.VarChar(100)
  shipping_state   String?   @db.VarChar(100)
  shipping_pincode String?   @db.VarChar(20)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  decided_at       DateTime?

  cust_user   cust_user     @relation(fields: [cust_user_id], references: [id], onDelete: Cascade)
  order_items order_items[]
}

// unit_price snapshots products.selling_price at submit time, so a later
// price change never retroactively alters an existing order's total.
model order_items {
  id              BigInt   @id @default(autoincrement())
  order_id        BigInt
  product_size_id BigInt
  quantity        BigInt
  unit_price      Decimal  @db.Decimal(10, 2)
  status          String   @default("active") @db.VarChar(20)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  orders         orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_sizes  product_sizes @relation(fields: [product_size_id], references: [id])
}
